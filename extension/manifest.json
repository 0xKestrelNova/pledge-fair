{
  "manifest_version": 3,
  "name": "Pledge Fair — Hangar",
  "version": "0.3.0",
  "description": "Calcule la valeur de fonte de ton hangar Star Citizen et l'exporte en CSV ou en JSON. Lecture seule, tout reste dans le navigateur.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://robertsspaceindustries.com/account/pledges*",
        "https://robertsspaceindustries.com/*/account/pledges*"
      ],
      "js": ["loader.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/panel.js",
        "src/collect.js",
        "src/extract.js",
        "src/value.js",
        "src/csv.js",
        "src/json.js",
        "src/filename.js",
        "src/store.js",
        "src/rows.js"
      ],
      "matches": ["https://robertsspaceindustries.com/*"]
    }
  ]
}
